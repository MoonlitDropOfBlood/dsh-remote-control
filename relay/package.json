{
  "name": "@duke-dsh-plugins/dsh-remote-control-relay",
  "version": "1.1.6",
  "description": "Public WebSocket relay (dumb pipe) for dsh-remote-control. Implements contract section 4 transport frames only; never parses frame.data ciphertext. Optional native TLS (RELAY_TLS_CERT/RELAY_TLS_KEY) and hello-token gating (RELAY_TOKEN).",
  "type": "module",
  "main": "server.js",
  "bin": {
    "dsh-remote-control-relay": "./server.js"
  },
  "files": [
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "relay",
    "websocket",
    "remote-control",
    "end-to-end-encryption"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-remote-control.git",
    "directory": "relay"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-remote-control/tree/main/relay#readme",
  "bugs": {
    "url": "https://github.com/MoonlitDropOfBlood/dsh-remote-control/issues"
  },
  "dependencies": {
    "ws": "^8.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
