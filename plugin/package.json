{
  "name": "@duke-dsh-plugins/dsh-remote-control",
  "version": "1.1.6",
  "description": "Remote-control bridge for DeepSeek Harness: pairs a HarmonyOS phone app with the desktop Host over an end-to-end-encrypted public relay (WebSocket). Lets the phone list/create/switch sessions, send prompts, watch streamed replies, cancel turns, and answer approval and ask-user-question requests from anywhere; pushes Huawei Push Kit notifications (gracefully disabled when AGC is unconfigured) for approvals, questions, and turn completion. The pairing QR lives in the DSH settings panel (\"DSH Pocket\"). Fail-open by design: any relay timeout or fault hands the request back to the desktop answerer.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "market/index.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.1.5-rc.3 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "^0.1.5-rc.3 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  },
  "scripts": {
    "vendor:relay": "node scripts/vendor-relay.mjs",
    "vendor:relay:check": "node scripts/vendor-relay.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-remote-control.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-remote-control/tree/main/plugin#readme",
  "bugs": {
    "url": "https://github.com/MoonlitDropOfBlood/dsh-remote-control/issues"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public"
  }
}
