<full-backup-content>
    <!-- DataStore Preferences：多远程档案（relayUrl / channel / secret / relayToken） -->
    <exclude
        domain="file"
        path="datastore" />
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
